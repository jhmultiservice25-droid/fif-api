    "@prisma/client": "^6.14.0",
    "@scalar/nestjs-api-reference": "^1.2.16",
    "better-auth": "^1.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "prisma": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
